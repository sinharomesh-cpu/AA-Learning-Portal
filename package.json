{
  "name": "aa-pro",
  "version": "0.1.0",
  "private": true,
  "description": "AA Pro learning portal",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "hygiene": "node scripts/check-repo-hygiene.mjs",
    "tokens": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "test:hosted": "playwright test --config playwright.hosted.config.ts",
    "db:migrate": "node scripts/db-migrate.mjs",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e:real": "node scripts/e2e-real.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "heic-decode": "2.1.0",
    "libheif-js": "1.23.2",
    "next": "16.3.8",
    "otplib": "13.5.0",
    "pdfjs-dist": "6.4.299",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "unrs-resolver": false
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
