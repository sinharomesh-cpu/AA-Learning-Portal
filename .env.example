# AA Pro environment variables — NAMES ONLY.
# Copy to .env.local for local work. Never commit real values.
# Provider names stay generic until providers are chosen and approved.

# Phase 1 (UI shell, synthetic data only)
APP_BASE_URL=
APP_TIMEZONE_DEFAULT=
# Demo sign-in with sample data (OC-27). Development and tests only, except the approved
# hosted demo preview (OC-34), which also sets AA_HOSTED_DEMO=true. A demo build refuses to
# start if any real-service setting below is filled in.
AA_DEMO_MODE=
AA_HOSTED_DEMO=

# Phase 2 (authentication and data)
DATABASE_URL=
# Optional: connection pool size per server process (default 5).
DATABASE_POOL_MAX=
# Server secret for keyed hashes (sign-in throttling). At least 32 random characters.
# Never commit a real value. Demo builds refuse to start if it is set (OC-34).
AUTH_SECRET=

# Development and tests only: shows the email outbox at /dev/mailbox (never in production).
AA_DEV_MAILBOX=

# Phase 4 (uploads and library)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Phase 5 (AI classroom)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Phase 6 (Zoom, after the spike and D-10)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Phase 7 (notifications)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
# WhatsApp later, after consent and provider readiness
WHATSAPP_PROVIDER_API_KEY=

# Tests only: pins the demo clock to HH:MM today in Asia/Kolkata (ignored outside demo mode).
AA_DEMO_CLOCK=
