# AA Pro environment variables — NAMES ONLY.
# Copy to .env.local for local work. Never commit real values.
# Provider names stay generic until providers are chosen and approved.

# Phase 1 (UI shell, synthetic data only)
APP_BASE_URL=
APP_TIMEZONE_DEFAULT=
# Demo sign-in with sample data (OC-27). Development and tests only, except the approved
# hosted demo preview (OC-34), which also sets AA_HOSTED_DEMO=true. A demo build refuses to
# start if any real-service setting below is filled in.
AA_DEMO_MODE=
AA_HOSTED_DEMO=

# Phase 2 (authentication and data)
DATABASE_URL=
# Optional: connection pool size per server process (default 5).
DATABASE_POOL_MAX=
# Server secret for keyed hashes (sign-in throttling). At least 32 random characters.
# Never commit a real value. Demo builds refuse to start if it is set (OC-34).
AUTH_SECRET=

# Development and tests only: shows the email outbox at /dev/mailbox (never in production).
AA_DEV_MAILBOX=
# Direct (non-pooled) connection used only to run migrations, when the host provides one.
DATABASE_URL_UNPOOLED=
# The owner's email: the only address that can set up the Super Admin (OC-50, /setup).
AA_SUPERADMIN_EMAIL=

# Test environment only (A-10): puts the whole site behind a shared access password.
AA_TEST_ENVIRONMENT=
AA_TEST_ACCESS_PASSWORD=

# Phase 4 (uploads and library)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Phase 5 (AI classroom)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Phase 6 (Zoom, after the spike and D-10)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Email (OC-133: Resend free plan only, ₹0). Off unless EVERY line below is set correctly.
# Set these in Vercel (aa-pro-test, Production only). Never in Preview, never NEXT_PUBLIC_.
# See docs/deployment/Email_Resend_Setup.md.
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
# "on" to send; anything else keeps email in the test mailbox only.
EMAIL_SENDING=
# Comma-separated test recipients. Nobody else is emailed.
EMAIL_ALLOWED_RECIPIENTS=
# Leave empty. "true" sends to every user and needs the owner's written approval.
EMAIL_ALLOW_ALL_RECIPIENTS=
# AA Pro's own caps (defaults 90 a day, 2900 a month; must stay within Resend free 100 / 3000).
EMAIL_DAILY_LIMIT=
EMAIL_MONTHLY_LIMIT=
# WhatsApp later, after consent and provider readiness
WHATSAPP_PROVIDER_API_KEY=

# Tests only: pins the demo clock to HH:MM today in Asia/Kolkata (ignored outside demo mode).
AA_DEMO_CLOCK=
